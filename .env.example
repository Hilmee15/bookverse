# ==============================================================
# BookVerse - environment variables (EXAMPLE)
# Copy this file to .env before running docker compose:
#   cp .env.example .env
# All values below are DUMMY data, safe to commit.
# ==============================================================

# --- PostgreSQL (used by the db service) ---
POSTGRES_USER=bookuser
POSTGRES_PASSWORD=bookpass
POSTGRES_DB=bookverse

# --- Backend ---
# The host is the compose SERVICE NAME ("db"), not localhost,
# because containers talk over the user-defined network.
DATABASE_URL=postgresql+psycopg2://bookuser:bookpass@db:5432/bookverse
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300
