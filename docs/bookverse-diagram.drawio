        </mxCell>
        <mxCell id="fe" value="frontend&#10;nginx + React (static)&#10;:80 → localhost:3000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB" vertex="1" parent="1">
