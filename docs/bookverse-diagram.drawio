      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="net" value="booknet — user-defined bridge network" style="rounded=1;dashed=1;fillColor=#F5F5F4;strokeColor=#999999;verticalAlign=top;fontStyle=1;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="260" y="70" width="760" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="browser" value="Browser&#10;(pengguna)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706" vertex="1" parent="1">
