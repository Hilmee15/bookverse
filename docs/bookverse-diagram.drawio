        </mxCell>
        <mxCell id="be" value="backend&#10;FastAPI + TF-IDF&#10;:8000 → localhost:8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A" vertex="1" parent="1">
          <mxGeometry x="610" y="115" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="redis" value="redis&#10;Redis 7 (cache, TTL 300s)&#10;:6379 — internal only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626" vertex="1" parent="1">
          <mxGeometry x="820" y="330" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="db&#10;PostgreSQL 16&#10;:5432 — internal only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA" vertex="1" parent="1">
          <mxGeometry x="580" y="330" width="170" height="80" as="geometry"/>
