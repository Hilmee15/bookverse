        <mxCell id="adminer" value="adminer (profile tools)&#10;:8080 → localhost:8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1" vertex="1" parent="1">
          <mxGeometry x="320" y="440" width="170" height="60" as="geometry"/>
