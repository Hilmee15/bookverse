        <mxCell id="e1" value="1 · HTTP localhost:3000" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10" edge="1" parent="1" source="browser" target="fe">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="2 · reverse proxy /api/* → backend:8000" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10" edge="1" parent="1" source="fe" target="be">
