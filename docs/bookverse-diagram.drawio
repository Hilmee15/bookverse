        <mxCell id="volpg" value="volume pgdata&#10;/var/lib/postgresql/data" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;size=10" vertex="1" parent="1">
          <mxGeometry x="600" y="455" width="130" height="70" as="geometry"/>
